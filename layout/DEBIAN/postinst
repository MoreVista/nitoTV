#! /bin/sh

# nitoHelper / setuid ラッパーに setuid ビットを立てる。
# AppleTV(Frontrow) は mobile ユーザーで動くため、これが無いと
# apt/dpkg が "Permission denied / are you root?" で失敗する。
# (deb 化/git は setuid ビットを保持しないため postinst で確実に設定する)
# 注意: この postinst は後半の hosts チェックで early-exit するため、
# setuid 設定は必ず先頭で行うこと。
chown root:wheel /usr/bin/nitoHelper /usr/libexec/nitotv/setuid 2>/dev/null || true
chmod 4755 /usr/bin/nitoHelper /usr/libexec/nitotv/setuid 2>/dev/null || true

FILE2=/var/mobile/Media/Photos/seas0nTV.png
FILE3=/var/mobile/Media/Photos/spicon.png
FILE4=/Library/MobileSubstrate/DynamicLibraries/apocalypsePony
FILE4FULL=$FILE4.dylib
FILE5=/var/mobile/Library/Preferences/spicon.png


if [ -f $FILE2 ];
then
   echo "File $FILE2 exists. removing..."
   rm $FILE2
fi

if [ -f $FILE3 ];
then
   echo "File $FILE3 exists. removing..."
   rm $FILE3
fi

if [ -f $FILE4FULL ];
then
   echo "File $FILE3 exists. removing..."
   rm $FILE4*
fi

if [ -f $FILE5 ];
then
   echo "File $FILE5 exists. removing..."
   rm $FILE5
fi



# remove ultra snow repo, it is useless on appletv

currentDir=`pwd`
sources=/etc/apt/sources.list.d

cd $sources
sed '/deb http:\/\/repo666.ultrasn0w.com\/ .\//d' cydia.list > tmp
mv tmp cydia.list
cd $currentDir

while read line    
do    
	if [[ $line == *127.0.0.1*mesu.apple.com* ]]; then
		echo "no need to edit hosts!";
		exit 0;
	fi
done < /etc/hosts

echo "127.0.0.1	mesu.apple.com" >> /etc/hosts
echo "127.0.0.1	appldnld.apple.com" >> /etc/hosts
echo "127.0.0.1	appldnld.apple.com.edgesuite.net" >> /etc/hosts

# restart Frontrow so the new appliance is picked up
killall AppleTV 2>/dev/null || true

exit 0;
